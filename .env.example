# Resend — used by /api/contact to send messages from the contact form.
# Without RESEND_API_KEY the form will validate but only log payloads server-side.
RESEND_API_KEY=

# Verified sender. The default `onboarding@resend.dev` only delivers to the
# email tied to your Resend account — verify a domain in production.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where contact-form messages land.
CONTACT_TO_EMAIL=raylak82@gmail.com
